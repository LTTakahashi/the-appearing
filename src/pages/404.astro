---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---
<BaseLayout title={`Page not found · ${site.name}`} path="/404">
  <section class="wrap notfound">
    <p class="kicker">404</p>
    <h1 class="serif">Page not found</h1>
    <p class="lead">The page you were looking for doesn’t exist or has moved.</p>
    <p><a href="/">Back to the homepage</a></p>
  </section>
</BaseLayout>

<style>
  .notfound { padding-top: 96px; padding-bottom: 120px; }
  h1 {
    margin: 14px 0 18px;
    font-size: clamp(40px, 6vw, 64px);
    line-height: 1.02;
    letter-spacing: -0.025em;
  }
  .lead { color: var(--ink-2); margin-bottom: 20px; max-width: 46ch; }
</style>
