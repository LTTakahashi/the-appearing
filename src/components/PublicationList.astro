---
import type { CollectionEntry } from 'astro:content';
import LinkChips from './LinkChips.astro';

type PubEntry = CollectionEntry<'publications'>;

interface Props {
  items: PubEntry[];
}

const TYPE_LABEL = { journal: 'Journal', abstract: 'Conference abstract', software: 'Software' } as const;

const items = Astro.props.items
  .filter((p) => p.data.selected)
  .sort((a, b) => a.data.order - b.data.order);
---
<ol class="pubs">
  {items.map(({ data: p }) => (
    <li>
      <p class="kicker">{[TYPE_LABEL[p.type], p.status].filter(Boolean).join(' · ')}</p>
      <h3 class="serif">{p.title}</h3>
      {p.authors.length > 0 && (
        <p class="authors">
          {p.authors.map((a, i) => (
            <>{i > 0 && ', '}{a === p.self ? <strong>{a}</strong> : a}</>
          ))}
        </p>
      )}
      <p class="venue">{p.venue}</p>
      <LinkChips links={p.links} variant="chip" />
    </li>
  ))}
</ol>

<style>
  .pubs {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }
  li {
    padding: 18px 0;
    border-bottom: 1px solid var(--rule);
  }
  .kicker { margin-bottom: 6px; font-size: 11.5px; letter-spacing: 0.1em; }
  h3 {
    margin-bottom: 6px;
    font-size: 20px;
    line-height: 1.3;
  }
  .authors,
  .venue {
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .authors strong { color: var(--ink); font-weight: 600; }
  .venue { font-style: italic; margin: 4px 0 10px; }
</style>
