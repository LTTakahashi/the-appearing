  <line class="is" x1="40" y1="250" x2="370" y2="250" stroke-width="1.5"></line>
  <line class="is" x1="40" y1="40" x2="40" y2="250" stroke-width="1.5"></line>
  <rect class="i" x="40" y="172" width="330" height="48" opacity="0.07"></rect>
  <line class="is" x1="40" y1="196" x2="370" y2="196" stroke-width="1.2" stroke-dasharray="4 4" opacity="0.55"></line>
  <path class="a" d="M50,186 C110,128 170,90 240,78 S330,68 360,66 L360,110 C330,112 300,116 240,122 C170,134 110,172 50,234 Z" opacity="0.18"></path>
  <path class="as" d="M50,210 C110,150 170,112 240,100 S330,90 360,88" fill="none" stroke-width="2.6"></path>
