    <circle cx="302" cy="90" r="3.8"></circle><circle cx="324" cy="96" r="3.8"></circle>
    <circle cx="346" cy="86" r="3.8"></circle>
  </g>
  <circle class="a" cx="280" cy="152" r="5"></circle>
  <circle class="as" cx="280" cy="152" r="11" fill="none" stroke-width="1.5"></circle>
  <rect width="400" height="300" filter="url(#grain-praxis)"></rect>
</svg>
