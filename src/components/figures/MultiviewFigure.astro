---
import Grain from './Grain.astro';

// Left: pooled points with a steep apparent trend (accent). Right: the same points
// split by cohort (filled vs outlined), each flat within its cohort.
const cohortA = [[62, 205], [74, 196], [85, 212], [96, 200], [104, 208], [70, 214], [90, 192]];
const cohortB = [[126, 110], [138, 100], [150, 116], [160, 104], [170, 112], [132, 120], [156, 96]];
const SHIFT = 180;
---
<svg class="fig" viewBox="0 0 400 300" role="img" aria-label="Illustration: an apparent trend across pooled data disappears within each cohort, a Simpson's paradox.">
  <Grain id="grain-multiview" />
  <g class="is" stroke-width="1.5">
    <line x1="40" y1="250" x2="190" y2="250"></line><line x1="40" y1="60" x2="40" y2="250"></line>
    <line x1="220" y1="250" x2="370" y2="250"></line><line x1="220" y1="60" x2="220" y2="250"></line>
  </g>
  <line class="is" x1="205" y1="50" x2="205" y2="262" stroke-width="1" opacity="0.3"></line>

  <g class="i">
    {[...cohortA, ...cohortB].map(([x, y]) => <circle cx={x} cy={y} r="4.2"></circle>)}
  </g>
  <line class="as" x1="48" y1="228" x2="184" y2="84" stroke-width="2.6" stroke-linecap="round"></line>

  <g class="i">
    {cohortA.map(([x, y]) => <circle cx={x + SHIFT} cy={y} r="4.2"></circle>)}
  </g>
  <g class="is" fill="none" stroke-width="1.8">
    {cohortB.map(([x, y]) => <circle cx={x + SHIFT} cy={y} r="4"></circle>)}
  </g>
  <g class="is" stroke-width="2.2" stroke-linecap="round">
    <line x1={56 + SHIFT} y1="203" x2={112 + SHIFT} y2="203"></line>
    <line x1={120 + SHIFT} y1="108" x2={178 + SHIFT} y2="108"></line>
  </g>
  <rect width="400" height="300" filter="url(#grain-multiview)"></rect>
</svg>
