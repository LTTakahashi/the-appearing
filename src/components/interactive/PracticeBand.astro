---
import { DAYS, DEFAULT_DAY, FIXED, PLOT, VIEWBOX, geometry, state, x } from '../../lib/practice-band';

const g = geometry();
const s = state(DEFAULT_DAY);
const sel = g.points.find((p) => p.day === DEFAULT_DAY)!;
const id = 'pb-day';
---
<figure class="practice-band" data-practice-band>
  <p class="pb-kicker kicker">Interactive figure · simulated data</p>
  <h3 class="pb-title serif">Is this score a real drop, or just a slow day?</h3>
  <p class="pb-intro">Scores on a repeated test rise with practice. Drag through the days and compare two ways of deciding what is “normal”.</p>

  <div class="pb-chart-wrap">
    <svg class="fig pb-chart" viewBox={VIEWBOX} role="img"
      aria-label="Line chart of simulated daily scores over 14 days. A practice-aware expected-score band rises with practice; a fixed day-one range stays flat. The selected day is highlighted.">
      <g class="pb-grid">
        {[20, 15, 10].map((v) => <line x1={PLOT.left} x2={PLOT.right} y1={330 - (v - 4) * (300 / 18)} y2={330 - (v - 4) * (300 / 18)}></line>)}
      </g>
      <line class="is" x1={PLOT.left} x2={PLOT.right} y1={PLOT.bottom} y2={PLOT.bottom} stroke-width="1.2"></line>
      <g class="pb-axis">
        {[20, 15, 10, 5].map((v) => <text x="48" y={330 - (v - 4) * (300 / 18) + 4} text-anchor="end">{v}</text>)}
        <text x={x(1)} y="352" text-anchor="start">day 1</text>
        <text x={x(7)} y="352" text-anchor="middle">day 7</text>
        <text x={x(14)} y="352" text-anchor="end">day 14</text>
        <text x={PLOT.left} y="20">words correct</text>
      </g>

      <rect class="i" x={PLOT.left} y={g.fixed.top} width={PLOT.right - PLOT.left} height={g.fixed.height} opacity="0.07"></rect>
      <line class="is" x1={PLOT.left} x2={PLOT.right} y1={g.fixed.mid} y2={g.fixed.mid} stroke-width="1.2" stroke-dasharray="4 4" opacity="0.6"></line>
      <text class="pb-label" x={PLOT.left + 8} y={g.fixed.top + g.fixed.height + 15}>Fixed day-one range</text>

      <path class="a" d={g.bandPath} opacity="0.16"></path>
      <path class="as" d={g.meanPath} fill="none" stroke-width="2"></path>
      <text class="pb-label" x={PLOT.right - 4} y="48" text-anchor="end">Practice-aware expected band (95%)</text>

      <line class="pb-guide is" x1={sel.cx} x2={sel.cx} y1={PLOT.top} y2={PLOT.bottom} stroke-width="1" stroke-dasharray="2 3"></line>
      <circle class="pb-ring is" cx={sel.cx} cy={sel.cy} r="12" fill="none" stroke-width="1.5"></circle>

      {g.points.map((p) => (
        <circle class:list={['pb-dot', p.outside ? 'a is-outside' : 'i', { 'is-selected': p.day === DEFAULT_DAY }]}
          data-day={p.day} cx={p.cx} cy={p.cy} r={p.day === DEFAULT_DAY ? 7 : 4.5}></circle>
      ))}
      {g.points.map((p) => (
        <circle class="pb-point" data-day={p.day} cx={p.cx} cy={p.cy} r="16" aria-hidden="true"></circle>
      ))}
    </svg>
  </div>

  <div class="pb-controls">
    <label for={id} class="pb-slider-label meta">Day <span class="pb-slider-day">{s.day}</span> of {DAYS}</label>
    <input id={id} class="pb-slider" type="range" min="1" max={DAYS} step="1" value={s.day} />
  </div>

  <div class="pb-readout" aria-live="polite">
    <div class="pb-now">
      <p class="pb-day meta">Day {s.day}</p>
      <p class="pb-score-line serif"><span class="pb-score">{s.score.toFixed(1)}</span> <span class="pb-unit">words</span></p>
    </div>
    <div>
      <p class="pb-heading">Practice-aware band</p>
      <p class="pb-range meta">expects <span class="pb-band-range">{s.bandLo.toFixed(1)}–{s.bandHi.toFixed(1)}</span></p>
      <p class:list={['pb-band-verdict', { 'is-flag': s.bandFlag }]}>{s.bandVerdict}</p>
    </div>
    <div>
      <p class="pb-heading">Fixed day-one range</p>
      <p class="pb-range meta">expects {FIXED.lo.toFixed(1)}–{FIXED.hi.toFixed(1)}</p>
      <p class:list={['pb-fixed-verdict', { 'is-flag': s.fixedFlag }]}>{s.fixedVerdict}</p>
    </div>
  </div>

  <figcaption class="pb-caption meta">Simulated scores for illustration only, not study data. In the study, on people left out of the fit, a fixed day-one normal range covered 42.7% of later scores, while practice-aware 95% bands covered 93–97%.</figcaption>
</figure>

<script>
  import '../../scripts/practice-band.ts';
</script>

<style>
  .practice-band { margin: 0; }
  .pb-kicker { margin-bottom: 10px; }
  .pb-title { margin-bottom: 8px; font-size: 28px; line-height: 1.15; letter-spacing: -0.01em; }
  .pb-intro { margin-bottom: 20px; font-size: 15.5px; line-height: 1.55; color: var(--ink-2); }
  .pb-chart-wrap { padding: 8px 8px 4px; background: var(--paper-2); }
  .pb-chart { width: 100%; height: auto; }
  .pb-grid line { stroke: var(--rule); stroke-width: 1; }
  .pb-axis text { fill: var(--muted); font-family: var(--font-mono); font-size: 11px; }
  .pb-label { fill: var(--ink-2); font-family: var(--font-sans); font-size: 12px; }
  /* The chart scales down on phones; enlarge its text in SVG units to stay readable. */
  @media (max-width: 599px) {
    .pb-axis text { font-size: 22px; }
    .pb-label { font-size: 22px; }
  }
  .pb-dot { stroke: var(--paper-2); stroke-width: 2; transition: r 150ms ease; }
  .pb-point { fill: transparent; cursor: pointer; }
  .pb-point:focus { outline: none; }

  .pb-controls { display: none; align-items: center; gap: 16px; margin-top: 14px; }
  :global(.js) .pb-controls { display: flex; }
  .pb-slider-label { white-space: nowrap; font-size: 12.5px; }
  .pb-slider { flex: 1; min-width: 0; min-height: 44px; accent-color: var(--accent); }

  .pb-readout {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(180px, 100%), 1fr));
    gap: 16px 24px;
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--rule-strong);
  }
  .pb-day { font-size: 11.5px; letter-spacing: 0.1em; text-transform: uppercase; }
  .pb-score-line { font-size: 36px; line-height: 1.05; }
  .pb-unit { font-size: 17px; color: var(--ink-2); }
  .pb-heading { font-size: 13px; font-weight: 600; }
  .pb-range { margin: 2px 0 4px; font-size: 12.5px; }
  .pb-band-verdict, .pb-fixed-verdict { font-size: 15px; line-height: 1.45; color: var(--ink); }
  .is-flag { color: var(--accent); }
  .pb-caption { margin-top: 18px; font-size: 11.5px; line-height: 1.6; }
</style>
