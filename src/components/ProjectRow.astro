---
import type { CollectionEntry } from 'astro:content';
import LinkChips from './LinkChips.astro';
import { vtName } from '../lib/vt';

type ProjectData = CollectionEntry<'projects'>['data'];

interface Props {
  project: ProjectData;
  slug?: string;
  hasPage?: boolean;
}

const { project, slug, hasPage = false } = Astro.props;
const href = hasPage && slug ? `/research/${slug}/` : null;
const titleStyle = href && slug ? `view-transition-name: ${vtName('title', slug)}` : undefined;
---
<div class="project-row">
  <h3 class="serif" style={titleStyle}>{href ? <a href={href}>{project.title}</a> : project.title}</h3>
  <p class="summary">{project.summary}</p>
  <div class="side">
    <p class="meta">{project.role} · {project.status}</p>
    <LinkChips links={project.links} />
  </div>
</div>

<style>
  .project-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 32px;
    padding: 20px 0;
    border-bottom: 1px solid var(--rule);
  }
  h3 {
    flex: 1 1 260px;
    min-width: 0;
    font-size: 21px;
    line-height: 1.25;
  }
  .summary {
    flex: 2 1 380px;
    min-width: 0;
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .side {
    flex: 0 1 200px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
</style>
