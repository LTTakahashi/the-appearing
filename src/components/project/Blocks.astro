---
import type { CollectionEntry } from 'astro:content';
import TextBlock from './blocks/TextBlock.astro';

type Block = CollectionEntry<'projects'>['data']['blocks'][number];

interface Props {
  blocks: Block[];
}

const { blocks } = Astro.props;
---
<div class="blocks">
  {blocks.map((b) => {
    if (b.type === 'text') return <TextBlock heading={b.heading} body={b.body} />;
    return null;
  })}
</div>

<style>
  .blocks { display: flex; flex-direction: column; gap: 56px; margin-top: 56px; }
</style>
