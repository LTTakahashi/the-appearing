---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  caption: string;
}

const { image, alt, caption } = Astro.props;
---
<figure class="block-figure">
  <Image src={image} alt={alt} widths={[700, 1400]} sizes="(min-width: 900px) 700px, 100vw" />
  <figcaption class="meta">{caption}</figcaption>
</figure>

<style>
  .block-figure { margin: 0; }
  .block-figure :global(img) {
    display: block;
    width: 100%;
    height: auto;
    background: var(--paper-2);
  }
  figcaption { margin-top: 10px; }
</style>
