---
interface Props {
  slug: string;
  title: string;
}

const { slug, title } = Astro.props;
---
<nav class="more" aria-label="More research">
  <a class="all-research meta" href="/#research">← All research</a>
  <a class="next-project" href={`/research/${slug}/`}>
    <span class="label meta">Next project</span>
    <span class="title serif">{title} →</span>
  </a>
</nav>

<style>
  .more {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    margin-top: 80px;
    padding: 28px 0 72px;
    border-top: 1px solid var(--rule-strong);
  }
  .all-research { font-size: 13px; }
  .next-project { text-align: right; text-decoration: none; color: var(--ink); }
  .next-project .label {
    display: block;
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .next-project .title { font-size: 24px; line-height: 1.2; }
  .next-project:hover .title { color: var(--accent); }
</style>
