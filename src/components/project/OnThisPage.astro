---
export interface TocItem {
  label: string;
  id: string;
}

interface Props {
  items: TocItem[];
}

const { items } = Astro.props;
---
<nav class="on-this-page" aria-label="On this page">
  <p class="label meta">On this page</p>
  <ol>
    {items.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}
  </ol>
</nav>

<style>
  .on-this-page { font-size: 14px; }
  .label {
    margin-bottom: 12px;
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  ol {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
    border-left: 1px solid var(--rule);
  }
  a {
    display: block;
    margin-left: -1px;
    padding: 6px 0 6px 14px;
    border-left: 2px solid transparent;
    color: var(--ink-2);
    text-decoration: none;
  }
  a:hover { color: var(--ink); }
  a[aria-current='true'] {
    border-left-color: var(--accent);
    color: var(--ink);
    font-weight: 500;
  }
  @media (min-width: 1024px) {
    .on-this-page { position: sticky; top: 24px; }
  }
</style>
