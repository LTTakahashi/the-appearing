---
import { renderInline } from '../../lib/format';

interface Props {
  items: string[];
}

const { items } = Astro.props;
---
<section id="in-one-minute" class="minute" aria-labelledby="in-one-minute-title">
  <h2 id="in-one-minute-title" class="kicker">In one minute</h2>
  <ol>
    {items.map((m) => <li set:html={renderInline(m)} />)}
  </ol>
</section>

<style>
  .minute {
    padding: 26px 30px 28px;
    background: var(--paper-2);
    scroll-margin-top: 24px;
  }
  h2 { margin-bottom: 14px; font-weight: 400; }
  ol {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
    padding-left: 20px;
    font-size: 16.5px;
    line-height: 1.55;
  }
  li :global(strong) { font-weight: 600; }
</style>
