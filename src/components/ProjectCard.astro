---
import type { CollectionEntry } from 'astro:content';
import LinkChips from './LinkChips.astro';
import { figures } from './figures';

type ProjectData = CollectionEntry<'projects'>['data'];

interface Props {
  project: ProjectData;
}

const { project } = Astro.props;
const Figure = project.figure ? (figures[project.figure] as any) : null;
---
<article class="project-card">
  {Figure && <div class="figure"><Figure /></div>}
  {project.kicker && <p class="kicker">{project.kicker}</p>}
  <h3 class="serif">{project.title}</h3>
  <p class="summary">{project.summary}</p>
  <p class="meta">{project.role} · {project.status}</p>
  <LinkChips links={project.links} />
</article>

<style>
  .project-card { min-width: 0; }
  .figure {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--paper-2);
  }
  .figure :global(svg) {
    width: 100%;
    height: 100%;
    transition: transform 300ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .project-card:hover .figure :global(svg),
  .project-card:focus-within .figure :global(svg) {
    transform: scale(1.02);
  }
  .kicker { margin: 18px 0 8px; }
  h3 {
    margin-bottom: 10px;
    font-size: 26px;
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    text-decoration-color: transparent;
    transition: text-decoration-color 200ms ease;
  }
  .project-card:hover h3,
  .project-card:focus-within h3 { text-decoration-color: var(--accent); }
  .summary {
    margin-bottom: 14px;
    font-size: 15.5px;
    line-height: 1.58;
    color: var(--ink-2);
  }
  .meta { margin-bottom: 8px; }
</style>
